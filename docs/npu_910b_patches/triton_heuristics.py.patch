+_npu_flex_autotune_lock_depth = 0
+_npu_flex_autotune_lock_file = None
+
+
+def _acquire_npu_flex_autotune_lock() -> None:
+    global _npu_flex_autotune_lock_depth, _npu_flex_autotune_lock_file
+    if _npu_flex_autotune_lock_depth:
+        _npu_flex_autotune_lock_depth += 1
+        return
+    lock_file = open("/tmp/npu_flex_attention_autotune.lock", "a")
+    fcntl.flock(lock_file, fcntl.LOCK_EX)
+    _npu_flex_autotune_lock_file = lock_file
+    _npu_flex_autotune_lock_depth = 1
+
+
+def _release_npu_flex_autotune_lock() -> None:
+    global _npu_flex_autotune_lock_depth, _npu_flex_autotune_lock_file
+    _npu_flex_autotune_lock_depth -= 1
+    if _npu_flex_autotune_lock_depth:
+        return
+    lock_file = _npu_flex_autotune_lock_file
+    _npu_flex_autotune_lock_file = None
+    if lock_file is not None:
+        fcntl.flock(lock_file, fcntl.LOCK_UN)
+        lock_file.close()
